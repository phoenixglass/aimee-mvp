ELEVENLABS_API_KEY=sk_69fcea7d041c57da3cf413b950282219888b25dfb4964fcd

SF_CALLBACK_URL=http://localhost:5000/salesforce/callback
FLASK_SECRET_KEY=aimee-secret-key-2026

# ── Flask session secret (required for OAuth CSRF state) ──────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_random_secret

# ── Salesforce Connected App credentials ──────────────────────────────────
# Authentication is attempted in this order:
#
#   1. JWT Bearer Token (recommended — does NOT require SOAP login):
#      Set SF_PRIVATE_KEY or SF_PRIVATE_KEY_FILE.  No password needed.
#      Connected App must have "Use Digital Signatures" enabled and the
#      matching public certificate uploaded.
#
#   2. OAuth2 Username-Password grant (legacy fallback):
#      Set SF_PASSWORD (+ SF_CONSUMER_SECRET).  Will fail if the org has
#      "Disable SOAP API login" turned on.
#
# Common to both flows:
# See setup instructions: docs/salesforce_setup.md
SF_CONSUMER_KEY=your_connected_app_consumer_key
SF_CONSUMER_SECRET=your_connected_app_consumer_secret
SF_DOMAIN=login

# ── Salesforce OAuth2 Web Server flow ─────────────────────────────────────
# Must exactly match the Callback URL configured in your Connected App.
# For local dev: http://localhost:5000/salesforce/callback
SF_CALLBACK_URL=http://localhost:5000/salesforce/callback

# ── Salesforce Username-Password fallback (optional) ──────────────────────
# Only needed if you want the app to auto-connect without the browser login flow.
SF_USERNAME=your_salesforce_email@example.com
SF_CONSUMER_KEY=your_connected_app_consumer_key
SF_DOMAIN=login

# ── JWT Bearer Token flow (recommended) ───────────────────────────────────
# Option A — inline PEM key (replace newlines with \n):
# SF_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
#
# Option B — path to a PEM key file:
# SF_PRIVATE_KEY_FILE=/path/to/server.key

# ── OAuth2 Username-Password grant (legacy fallback) ──────────────────────
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token
SF_CONSUMER_SECRET=your_connected_app_consumer_secret
