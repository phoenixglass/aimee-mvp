ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Flask session secret (required for OAuth CSRF state) ──────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# ── Salesforce Connected App credentials ──────────────────────────────────
# Authentication flows (in preference order):
#
#   1. OAuth 2.0 Web Server flow (browser-based login, recommended):
#      Visit http://localhost:5000/salesforce/login to authenticate.
#      No password or private key needed — just approve in the browser.
#      Requires: SF_CONSUMER_KEY, SF_CONSUMER_SECRET, SF_CALLBACK_URL
#
#   2. JWT Bearer Token flow (server-to-server, no browser):
#      Set SF_PRIVATE_KEY or SF_PRIVATE_KEY_FILE.
#      Requires: SF_USERNAME, SF_CONSUMER_KEY, SF_PRIVATE_KEY / SF_PRIVATE_KEY_FILE
#
# NOTE: OAuth2 Username-Password grant is disabled — SOAP API login is turned
#       off in this org (INVALID_OPERATION).  Do NOT set SF_PASSWORD.
#
# See setup instructions: docs/salesforce_setup.md

# Common to both flows:
SF_CONSUMER_KEY=your_connected_app_consumer_key
SF_CONSUMER_SECRET=your_connected_app_consumer_secret
SF_DOMAIN=login

# Web Server OAuth flow — callback URL must match your Connected App settings:
SF_CALLBACK_URL=http://localhost:5000/salesforce/callback

# JWT Bearer Token flow (optional — only if you have a digital certificate):
SF_USERNAME=your_salesforce_email@example.com
# Option A — inline PEM key (replace newlines with \n):
# SF_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
#
# Option B — path to a PEM key file:
# SF_PRIVATE_KEY_FILE=/path/to/server.key
